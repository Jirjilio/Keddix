# Workflow de despliegue automático (preparado pero NO activado todavía).
#
# Para activarlo:
# 1. Copia este archivo a .github/workflows/deploy.yml.
#    GitHub exige un token con permiso "workflow" para subir ese archivo,
#    o hacerlo desde la interfaz web iniciando sesión en GitHub.
# 2. En Settings → Pages → Build and deployment, pon Source = "GitHub Actions".
# 3. En Settings → Secrets and variables → Actions, crea los seis secretos
#    VITE_FIREBASE_* con los valores de tu proyecto Firebase.
#
# La ruta base se calcula sola desde el nombre del repositorio, así que un
# futuro rename no necesita cambios en el código.

name: Deploy to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - run: npm ci

      # Vite solo conserva en el bundle las variables que existen aquí.
      # Los valores vienen de los secretos configurados en el repositorio.
      - run: npm run build
        env:
          VITE_BASE_PATH: /${{ github.event.repository.name }}/
          VITE_FIREBASE_API_KEY: ${{ secrets.VITE_FIREBASE_API_KEY }}
          VITE_FIREBASE_AUTH_DOMAIN: ${{ secrets.VITE_FIREBASE_AUTH_DOMAIN }}
          VITE_FIREBASE_PROJECT_ID: ${{ secrets.VITE_FIREBASE_PROJECT_ID }}
          VITE_FIREBASE_STORAGE_BUCKET: ${{ secrets.VITE_FIREBASE_STORAGE_BUCKET }}
          VITE_FIREBASE_MESSAGING_SENDER_ID: ${{ secrets.VITE_FIREBASE_MESSAGING_SENDER_ID }}
          VITE_FIREBASE_APP_ID: ${{ secrets.VITE_FIREBASE_APP_ID }}

      - uses: actions/configure-pages@v5

      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    runs-on: ubuntu-latest
    needs: build
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
